# .env.example — required keys for LOCAL development of ContentRemixer
# (ISI-7078). Placeholder values only: NEVER put real secrets in this file
# or anywhere in the repo (design §8). In-cluster, all of these arrive via
# Kubernetes Secrets referenced by SecretKeyRef — see
# deploy/secrets/*.example.yaml and deploy/secrets/models.example.yaml.

# --- Model backends (LiteLLM gateway) --------------------------------------
# Master key the gateway would require on its own API (reserved for when the
# gateway is exposed beyond the namespace; not wired in Phase 1, where the
# litellm Service is cluster-internal only — design §7).
LITELLM_MASTER_KEY=

# Per-provider model keys. Each ModelProfile CR that needs a key references
# one of these via spec.apiKeyRef (name + key), e.g. the "fast-openai"
# profile references Secret `openai-apikey`, key `key` — which in local dev
# maps to this file's OPENAI_API_KEY.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- GitHub (webhook receiver + PR assembly; subtasks D/H) -----------------
# App creds for the GitHub App integration.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# PAT used to clone the reference repo (ReferenceRepo.spec.tokenRef).
GITHUB_PAT=

# --- Operator runtime -------------------------------------------------------
# Where the analyzer/writer agents reach the LiteLLM gateway.
LITELLM_BASE_URL=http://localhost:4000
# Which alias the pipeline uses when a job does not pin a model; must match
# the litellmName of the ModelProfile with spec.default=true.
CONTENTREMIXER_DEFAULT_MODEL=default
