# Node / Vite workspace. node_modules is never committed; dist IS committed so the
# Booth Go build can embed it (embed.FS, §2) without a JS toolchain in booth-ci.
# web-ci rebuilds dist and fails if it drifts from source (lockstep).
node_modules/
.vite/
*.local
npm-debug.log*

# Playwright E2E (ISI-7214, W8) — transient run artifacts; the specs under e2e/
# and playwright.config.ts ARE committed, the outputs are not.
test-results/
playwright-report/
blob-report/
.playwright/
