# demo-recorder runtime image (ISI-7388 / DR-2, ISI-7400).
#
# Packages the Playwright→MP4 demo recorder so an agent can run `record.mjs`
# (DR-1, ISI-7399) with a cold start < 2 min: a cold pull of THIS image followed
# by a completed trivial record. Nothing is installed at container start.
#
# Base = the official Playwright image, which bakes Node, the browsers, AND every
# system dependency (libatk/libgbm/… — the libs that bite a bare-node image, see
# the D8 E2E footgun ISI-7363). We add exactly one thing: ffmpeg, to transcode the
# Chromium WebM into a faststart MP4 (DR R4). We do NOT run `playwright install`:
# the browsers are already baked and PINNED to this image's Playwright version.
#
# CONTRACT (coordinated with DR-1, ISI-7399): the `playwright` npm version in
# package.json MUST equal the base image tag — here 1.64.0 == v1.64.0-noble. If
# DR-1 bumps one, bump both. PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 makes `npm ci`
# trust the baked browsers instead of re-downloading them (keeps the image slim
# and the build offline-from-browsers).
#
# Published as ghcr.io/contentremixer/demo-recorder by
# demo-recorder-image-publish.yml, multi-arch (linux/amd64, linux/arm64),
# cosign keyless-signed with SBOM + max provenance — the scrape-job lane
# (ISI-7343) shape.
FROM mcr.microsoft.com/playwright:v1.64.0-noble

# ffmpeg = the only extra system dep over the Playwright base. Clean the apt
# lists in the same layer so they never ship in the image.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Trust the baked-in browsers; never re-download on `npm ci` or at runtime.
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    NODE_ENV=production

# Dependency layer FIRST (package*.json only) so source edits don't bust the
# npm cache — the expensive layer stays warm across record.mjs changes.
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund

# Source last. record.mjs + lib/* are DR-1 (ISI-7399) deliverables; smoke.mjs is
# the self-contained cold-start probe shipped with the runtime. The glob COPYs
# whatever the scaffold provides without churning this Dockerfile. --chown gives
# the non-root runtime user ownership of the app tree it executes.
COPY --chown=pwuser:pwuser . .

# OpenContainers image metadata (org.opencontainers.image.*).
LABEL org.opencontainers.image.title="demo-recorder" \
      org.opencontainers.image.description="Playwright->MP4 demo recorder runtime (browsers + ffmpeg baked in)" \
      org.opencontainers.image.source="https://github.com/ContentRemixer/Contentremixer" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.base.name="mcr.microsoft.com/playwright:v1.64.0-noble"

# Drop to the non-root user baked into the Playwright image (uid 1000). The build
# steps above (apt, npm ci, COPY) need root; the recorder itself runs
# unprivileged — this is both the Trivy DS-0002 fix and the Playwright-recommended
# way to run this image. Chromium runs fine as pwuser; smoke.mjs also passes
# --no-sandbox so it survives hardened CI seccomp profiles.
USER pwuser

# No ENTRYPOINT that auto-runs a recording: an agent (or the DR-3 E2E, ISI-7401)
# drives the container with an explicit `node record.mjs <scenario>`. Default to a
# shell so `docker run <img> node smoke.mjs` and ad-hoc use both work.
CMD ["bash"]
